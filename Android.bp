android_app {
    name: "SimpleDeviceConfig",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    platform_apis: true,
    system_ext_specific: true,
    certificate: "platform",
    privileged: true,
    manifest: "AndroidManifest.xml",
}
